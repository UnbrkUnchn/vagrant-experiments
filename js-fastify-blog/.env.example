# Адрес базы. Пока он не задан, блог поднимает PostgreSQL внутри процесса через
# PGlite, и ставить ничего не нужно. Для деплоя указывается настоящий сервер:
# строкой подключения целиком либо частями по отдельности ниже.
DATABASE_URL=postgres://vagrant:vagrant@localhost:5432/vagrant

DATABASE_NAME=vagrant
DATABASE_USERNAME=vagrant
DATABASE_PASSWORD=vagrant
DATABASE_PORT=5432
DATABASE_HOST=localhost
